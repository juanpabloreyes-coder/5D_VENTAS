<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Igual que los otros add-ins de VENTAS: net8.0 para Revit 2025. Sin librerias externas
         (el Excel se escribe con Open XML a mano para no chocar con las de GCP_PLUGIN). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <AssemblyName>Sync5D</AssemblyName>
    <RootNamespace>Ventas5D.Sync5D</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Recursos\Plantilla_Presupuesto_5D.xlsx" />
    <EmbeddedResource Include="Recursos\exportar_32.png" />
    <EmbeddedResource Include="Recursos\exportar_16.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ajusta esta ruta si Revit esta instalado en otro lugar. -->
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
